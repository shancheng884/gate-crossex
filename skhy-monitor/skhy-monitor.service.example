[Unit]
Description=SKHY Kraken-Gate Telegram monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/skhy-monitor
EnvironmentFile=/etc/skhy-monitor.env
ExecStart=/usr/bin/node /opt/skhy-monitor/src/monitor.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skhy-monitor/data

[Install]
WantedBy=multi-user.target
